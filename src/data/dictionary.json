      "icon": "📜",
      "entries": [
        {
          "id": "prv_001",
          "kab_latin": "Win yebγan tamment, yesseṛ tisent",
          "kab_tifinagh": "ⵡⵉⵏ ⵢⴱⵖⴰⵏ ⵜⴰⵎⵏⵜ, ⵢⵙⵙⵕ ⵜⵉⵙⵏⵜ",
          "fr": "Qui veut du miel doit supporter les piqûres",
          "ar": "من يريد العسل يتحمل لسعات النحل",
          "en": "Who wants honey must endure the bee stings",
          "phonetic": "win yeb-ghan ta-ment, yes-ser ti-sent",
          "usage": "Sur l'effort et la récompense"
        },
        {
          "id": "prv_002",
          "kab_latin": "Yiwen ufus ur ičeṭṭeḥ",
          "kab_tifinagh": "ⵢⵉⵡⵏ ⵓⴼⵓⵙ ⵓⵔ ⵉⵛⵟⵟⵃ",
          "fr": "Une seule main n'applaudit pas",
          "ar": "يد واحدة لا تصفق",
          "en": "One hand doesn't clap",
          "phonetic": "yi-wen ou-fous our i-chet-teh",
          "usage": "Sur l'entraide"
        },
        {
          "id": "prv_003",
          "kab_latin": "Awal n lxir d asawen",
          "kab_tifinagh": "ⴰⵡⴰⵍ ⵏ ⵍⵅⵉⵔ ⴷ ⴰⵙⴰⵡⵏ",
          "fr": "La bonne parole s'élève",
          "ar": "الكلمة الطيبة ترتفع",
          "en": "Good words rise up",
          "phonetic": "a-wal n l-khir d a-sa-wen",
          "usage": "Sur la bonté"
        },
        {
          "id": "prv_004",
          "kab_latin": "Ur yelli fell-as d acu ara yeččar",
          "kab_tifinagh": "ⵓⵔ ⵢⵍⵍⵉ ⴼⵍⵍ-ⴰⵙ ⴷ ⴰⵛⵓ ⴰⵔⴰ ⵢⵛⵛⴰⵔ",
          "fr": "Il n'y a rien qui le remplisse",
          "ar": "لا شيء يملأه",
          "en": "Nothing can fill it",
          "phonetic": "our yel-li fel-las d a-chou a-ra yet-char",
          "usage": "Sur l'avidité"
        },
        {
          "id": "prv_005",
          "kab_latin": "Aqerru n wuccen d yiwet tikkelt",
          "kab_tifinagh": "ⴰⵇⵔⵔⵓ ⵏ ⵡⵓⵛⵛⵏ ⴷ ⵢⵉⵡⵜ ⵜⵉⴽⴽⵍⵜ",
          "fr": "On ne voit la tête du chacal qu'une fois",
          "ar": "رأس ابن آوى لا يُرى إلا مرة واحدة",
          "en": "The jackal's head is seen only once",
          "phonetic": "a-qer-rou n wou-chen d yi-wet tik-kelt",
          "usage": "Sur la rareté et la méfiance"
        },
        {
          "id": "prv_006",
          "kab_latin": "Aγyul ur yezmir ad yili d aɛudiw",
          "kab_tifinagh": "ⴰⵖⵢⵓⵍ ⵓⵔ ⵢⵣⵎⵉⵔ ⴰⴷ ⵢⵉⵍⵉ ⴷ ⴰⵄⵓⴷⵉⵡ",
          "fr": "L'âne ne peut pas être un cheval",
          "ar": "الحمار لا يمكن أن يكون حصانًا",
          "en": "A donkey cannot be a horse",
          "phonetic": "a-ghyoul our yez-mir ad yi-li d a-âou-diw",
          "usage": "Sur la nature de chacun"
        }
      ]
    },
